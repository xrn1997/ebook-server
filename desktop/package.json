{
  "name": "ebook-server-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:main": "tsc -p tsconfig.node.json --watch",
    "dev:renderer": "vite src/renderer",
    "start": "electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.build.json && npm run build:preload",
    "build:preload": "esbuild src/preload/index.ts --bundle --format=cjs --platform=node --external:electron --outfile=dist/preload/index.js",
    "build:renderer": "vite build src/renderer",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:preload": "electron scripts/preload-smoke.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && vue-tsc --noEmit -p tsconfig.json && tsc -p tsconfig.e2e.json --noEmit",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^15.11.7",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vue-tsc": "^2.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "electron@33.4.11": true
  }
}
