# =============================================================================
# Go (github/gitignore Go.gitignore)
# =============================================================================

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Project binary / build output (ADR-0009)
build/
ebook-server
ebook-server.exe

# Test binary, built with `go test -c`
*.test

# Coverage
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go workspace
go.work
go.work.sum

# =============================================================================
# Node.js (github/gitignore Node.gitignore)
# =============================================================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage (Node)
coverage/
*.lcov
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache
.npm

# Optional caches
.eslintcache
.stylelintcache

# Compiled binary addons
build/Release

# Output of 'npm pack'
*.tgz

# dotenv
.env
.env.*
!.env.example

# Bundler / framework caches
.cache
.parcel-cache
.next
out
.nuxt
dist
.output
.vuepress/dist
.temp
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Yarn
.yarn-integrity
.pnpm-store
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# =============================================================================
# JetBrains (github/gitignore Global/JetBrains.gitignore)
# =============================================================================

# User-specific
