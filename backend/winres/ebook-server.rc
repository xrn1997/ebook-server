/*
 * Windows VERSIONINFO for the Go server.
 *
 * The macros live in version.h, generated by generate.sh from the Makefile
 * VERSION variable. Keeping the fixed strings here means the PE metadata has
 * a stable publisher/product identity even when the build version changes.
 */
#include "version.h"

1 VERSIONINFO
FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,VERSION_BUILD
PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,VERSION_BUILD
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", VERSION_COMMENT
            VALUE "CompanyName", "ebook-server"
            VALUE "FileDescription", "ebook-server backend service"
            VALUE "FileVersion", VERSION_STR
            VALUE "InternalName", "ebook-server"
            VALUE "LegalCopyright", "Copyright (c) ebook-server contributors. Licensed under Apache-2.0."
            VALUE "OriginalFilename", "ebook-server.exe"
            VALUE "ProductName", "ebook-server"
            VALUE "ProductVersion", VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
