# 本地配置覆盖示例（复制为 .env 后填写真实值，.env 已被 git 排除）
# config.Load 会通过 viper 读入这些环境变量，覆盖 config.yaml 中的同名键。
#
# 两类键，处理方式不同：
#   - 敏感项（下方前三组）：真实值只放 .env，由 config.Load 覆盖 YAML；密钥不写进可提交配置。
#   - 非敏感项（SMTP 主机/端口/账号/发件人、数据库路径）：只做配置覆盖，
#     部署时直接写在 config.yaml 即可。
#
# 注意：release 模式会拒绝仍为占位值的凭据（your-secret-key-change-this、
# change-me-admin、your-admin-secret-change-this 等）——复制本文件不改内容就
# 上线，等于用一把全网读得到的密钥签名。

# JWT 签名密钥（生产至少 32 字符随机串）
JWT_SECRET=your-secret-key-change-this

# 后台管理员口令与后台 JWT 密钥（生产必须修改；后台登录不接受空口令）
ADMIN_PASSWORD=change-me-admin
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-this

# SMTP 授权码（发信邮箱服务商生成的「授权码」，勿填登录密码）
SMTP_PASSWORD=your-16-digit-auth-code

# SMTP 主机/端口/发信账号/发件人（默认从 config.yaml 读取；此处可覆盖，
# 尤其当你不希望真实账号出现在被追踪的 config.yaml 时，把它们放 .env）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=you@qq.com
SMTP_FROM=you@qq.com

# SQLite 数据库文件路径（相对服务的工作目录，即仓库根）
DATABASE_PATH=ebook.db

# 头像等公开资源的绝对 URL 来源（非敏感项，也可直接写 config.yaml）。
# 留空时按请求 Host 拼接，只适合受信网络；对外提供服务请钉死它，
# 例如 https://book.example.com（纯 origin，不带路径与查询）。
SERVER_PUBLIC_BASE_URL=
